{
	"nodes":[
		{"id":"grp_4","type":"group","x":1854,"y":6,"width":342,"height":2894,"color":"#2f2a3a","label":"5 · СОБЫТИЯ / БИТЫ"},
		{"id":"grp_3","type":"group","x":1384,"y":6,"width":342,"height":1604,"color":"#33332a","label":"4 · ПРЕДМЕТЫ"},
		{"id":"grp_2","type":"group","x":914,"y":6,"width":342,"height":1576,"color":"#2a3a2f","label":"3 · ЛОКАЦИИ"},
		{"id":"grp_0","type":"group","x":-26,"y":6,"width":342,"height":1316,"color":"#3a2a2a","label":"1 · ПЕРСОНАЖИ"},
		{"id":"grp_1","type":"group","x":444,"y":6,"width":342,"height":798,"color":"#2a2f3a","label":"2 · МОТИВЫ И ЦЕЛИ"},
		{"id":"grp_5","type":"group","x":2324,"y":6,"width":342,"height":1532,"color":"#2a3a3a","label":"6 · МЕХАНИКИ"},
		{"id":"grp_6","type":"group","x":2780,"y":-20,"width":342,"height":1434,"color":"#2a3340","label":"7 · ЗНАНИЯ (К1–К11)"},
		{"id":"grp_9","type":"group","x":4204,"y":6,"width":342,"height":1208,"color":"#322a3a","label":"10 · СКРЫТЫЙ ПЛАСТ"},
		{"id":"grp_7","type":"group","x":3264,"y":6,"width":342,"height":974,"color":"#3a2f2a","label":"8 · ТЕМЫ И СИМВОЛЫ"},
		{"id":"grp_8","type":"group","x":3734,"y":6,"width":342,"height":600,"color":"#33332f","label":"9 · ВЫБОРЫ / ВЕТВИ / ФЛАГИ"},
		{"id":"goal_path","type":"text","text":"**Цель: открыть путь**\n\nКорни перекрыли тропу и мост; нужно разрешить проблему дерева.","x":470,"y":196,"width":290,"height":92},
		{"id":"goal_lhamo","type":"text","text":"**Цель Лхамо**\n\nСпасти мать и найти отца — две задачи, что строят связь до лора.","x":470,"y":322,"width":290,"height":92},
		{"id":"goal_dolma","type":"text","text":"**Цель Долмы**\n\nЖить и не быть поглощённой тьмой и забытой как последняя в роду.","x":470,"y":448,"width":290,"height":92},
		{"id":"goal_tenzin","type":"text","text":"**Цель Тензина**\n\nИзбавить обитель от корней.","x":470,"y":574,"width":290,"height":78},
		{"id":"motive_spirit","type":"text","text":"**Мотив духа**\n\nНе пасть: присвоить чужую пунью и поддельное бессмертие.","x":470,"y":686,"width":290,"height":92,"color":"6"},
		{"id":"loc_cliff","type":"text","text":"**Утёс (камнепад)**\n\nМесто пробуждения силы.","x":940,"y":196,"width":290,"height":78},
		{"id":"item_tavro","type":"text","text":"**Тавро Лобсанга**\n\nРодовой знак; тот же на яках и утвари Долмы. Доказательство крови Зодчего.","x":1410,"y":70,"width":290,"height":110},
		{"id":"item_key","type":"text","text":"**Костяной ключ**\n\nКлюч к чтению бон. Лхамо плела «для друга». Награда ветви A.","x":1410,"y":214,"width":290,"height":92,"color":"4"},
		{"id":"item_oil","type":"text","text":"**Оливковое масло**\n\nБез кармического веса; «духи не видят». Ружьё инертной кармы.","x":1410,"y":340,"width":290,"height":92},
		{"id":"item_ghi","type":"text","text":"**Масло гхи**\n\nТопливо Жинсрэга и лампад. Связь огня внутри и снаружи.","x":1410,"y":466,"width":290,"height":92},
		{"id":"loc_trail","type":"text","text":"**Снежные тропы / колонны**\n\nВход. Столпы с письмом духов. Хранят фрагменты договора.","x":940,"y":70,"width":290,"height":92},
		{"id":"loc_ravine","type":"text","text":"**Обучающая расселина**\n\nПервый провал; рядом труп паломника.","x":940,"y":308,"width":290,"height":92},
		{"id":"loc_camp","type":"text","text":"**Стоянка Лхамо**\n\nШатёр матери, яки с тавро. Узел встреч и возвратов.","x":940,"y":434,"width":290,"height":92},
		{"id":"item_pots","type":"text","text":"**Горшки с саженцами**\n\nСаженцы со знаками бон, радужная искра дерева. Улика без объяснения.","x":1410,"y":1492,"width":290,"height":92},
		{"id":"lobsang","type":"text","text":"**Лобсанг**\n\nОтец Лхамо. Погиб в обходе, замёрз. Найден мёртвым в ущелье.","x":0,"y":358,"width":290,"height":92},
		{"id":"mother","type":"text","text":"**Мать Лхамо**\n\nТяжело больна (нинг-лунг), нетранспортабельна. Двигатель квеста медицины.","x":0,"y":484,"width":290,"height":110},
		{"id":"dolma","type":"text","text":"**Долма**\n\nПоследняя в роду Зодчего, замурована в тёмном доме. Цепляется за жизнь. Зеркало антагониста.","x":0,"y":628,"width":290,"height":110},
		{"id":"tenzin","type":"text","text":"**Тензин**\n\nКхенпо монастыря. Источник обучения, врачевания и раскрытий. Не может удержать героя в памяти.","x":0,"y":772,"width":290,"height":110},
		{"id":"tsongpa","type":"text","text":"**Цхонпа**\n\nКупец, чужеземный товар и лексикон, говорит вопросами. Опционально.","x":0,"y":916,"width":290,"height":92},
		{"id":"loc_burnt","type":"text","text":"**Обожжённое место**\n\nВыжженные скалы, белые лотосы, расколотая ступа с выгоревшим стержнем.","x":940,"y":1050,"width":290,"height":110},
		{"id":"loc_grotto","type":"text","text":"**Грот + питомник**\n\nИзваяния Будд; под ними потайные горшки. Загадка. Функция не задана.","x":940,"y":1194,"width":290,"height":92,"color":"3"},
		{"id":"loc_tree","type":"text","text":"**Дерево / дом Долмы**\n\nИсполин из дома Зодчего; дом тёмный, сырой, лампадный. Сердце договора.","x":940,"y":1320,"width":290,"height":110},
		{"id":"loc_menkhang","type":"text","text":"**Менкханг**\n\nЛечебница за мостом; цель полного исцеления матери.","x":940,"y":1464,"width":290,"height":92},
		{"id":"spirit","type":"text","text":"**Дух**\n\nСоздатель дерева. Физически отсутствует, рассеян в дереве и договоре. Подменил назначение ступы.","x":0,"y":1042,"width":290,"height":110,"color":"6"},
		{"id":"pilgrim","type":"text","text":"**Мёртвый паломник**\n\nСлишком долго стоял на месте; корни поглотили его. Первый источник кармы и каузальности.","x":0,"y":1186,"width":290,"height":110},
		{"id":"loc_monks","type":"text","text":"**Жилища монахов + мост**\n\nДом Тензина; мост к монастырю задушен корнями.","x":940,"y":560,"width":290,"height":92},
		{"id":"item_lotus","type":"text","text":"**Белые лотосы**\n\nЗримая осёдлая заслуга; сырьё снадобья.","x":1410,"y":592,"width":290,"height":92},
		{"id":"item_songsrang_cracked","type":"text","text":"**Сонгсранг расколотой ступы**\n\nВыгоревший шест: убьёт руку с кармой, но мало для дерева. Вещь узнавания и свопа.","x":1410,"y":718,"width":290,"height":110},
		{"id":"item_songsrang_live","type":"text","text":"**Сонгсранг действующей ступы**\n\nПолный заряд живой оси; нужен сжечь дерево. Изъятие убивает ступу.","x":1410,"y":862,"width":290,"height":92,"color":"1"},
		{"id":"item_remedy","type":"text","text":"**Снадобье**\n\nНа джинлабе из лотосов; усмиряет ветер. Облегчает, не исцеляет.","x":1410,"y":988,"width":290,"height":92},
		{"id":"item_copy","type":"text","text":"**Копия договора**\n\nНеполная (корни выели оговорку о властном расторгнуть).","x":1410,"y":1114,"width":290,"height":92},
		{"id":"item_song","type":"text","text":"**Песня Лхамо = договор**\n\nКолыбельная отца оказывается текстом договора.","x":1410,"y":1240,"width":290,"height":92},
		{"id":"item_columns","type":"text","text":"**Каменные колонны**\n\nФрагменты договоров и мантра о намерении.","x":1410,"y":1366,"width":290,"height":92},
		{"id":"loc_library","type":"text","text":"**Библиотека**\n\nДва пергамента. Опционально.","x":940,"y":686,"width":290,"height":78},
		{"id":"loc_stupa","type":"text","text":"**Обительская ступа**\n\nЦелая ступа; донор живой оси в ветви B.","x":940,"y":798,"width":290,"height":92},
		{"id":"loc_gorge","type":"text","text":"**Ущелье (Лобсанг)**\n\nТело Лобсанга; переправа дальше на его карме.","x":940,"y":924,"width":290,"height":92},
		{"id":"ev_dolma","type":"text","text":"**Дом Долмы: рассказ + лампады**\n\nЗажигает лампады, что открывают тавро/портреты/договор; виден отток праны; родство с Лхамо.","x":1880,"y":1680,"width":290,"height":110},
		{"id":"ev_copy","type":"text","text":"**Копирование договора**\n\nКопирует неполный текст со ствола.","x":1880,"y":1824,"width":290,"height":78},
		{"id":"ev_return_tenzin","type":"text","text":"**Возврат к Тензину: узнавание**\n\nСнадобье готово; реакция на сонгсранг → герой осознаёт, что он Опустошённый.","x":1880,"y":1936,"width":290,"height":110},
		{"id":"ev_return_lhamo","type":"text","text":"**Возврат к Лхамо**\n\nЛекарство матери; копия — её песня; роль намерения.","x":1880,"y":2206,"width":290,"height":92},
		{"id":"ev_choice","type":"text","text":"**Точка выбора**\n\nПередать тавро или сжечь дерево. Действие, не меню.","x":1880,"y":2332,"width":290,"height":92,"color":"3"},
		{"id":"ev_branchA","type":"text","text":"**Ветвь A: расторжение**\n\nТавро → Лхамо поёт с умыслом, герой держит корни; дерево и Лхамо растворяются; Долма выходит; мать — в менкханг; награда — ключ.","x":1880,"y":2458,"width":290,"height":128,"color":"4"},
		{"id":"ev_branchB","type":"text","text":"**Ветвь B: сожжение + своп**\n\nПодмена сонгсрангов; гневный Жинсрэг; дерево падает на дом, гибнет Долма, гаснут лампады; Лхамо не узнаёт крови; награда — сонгсранг.","x":1880,"y":2620,"width":290,"height":128,"color":"1"},
		{"id":"ev_promise","type":"text","text":"**Обещание подарка**\n\nЛхамо обещает костяной ключ.","x":1880,"y":686,"width":290,"height":78},
		{"id":"ev_tsongpa","type":"text","text":"**(Опц.) Цхонпа**\n\nМасло, чужеземный лексикон, речь вопросами.","x":1880,"y":798,"width":290,"height":92},
		{"id":"ev_tenzin_teach","type":"text","text":"**Тензин: обучение и задание**\n\nУчит Жинсрэгу; поручает собрать благой цвет; вводит врачевание.","x":1880,"y":924,"width":290,"height":92},
		{"id":"ev_tenzin_lore","type":"text","text":"**Тензин: догадки и намерение**\n\nПроисхождение напасти; недавность корней; правило намерения.","x":1880,"y":1050,"width":290,"height":92},
		{"id":"ev_library","type":"text","text":"**Библиотека: пергаменты**\n\nДухи-движители скал; разряд ступы против корней.","x":1880,"y":1176,"width":290,"height":92},
		{"id":"ev_gorge","type":"text","text":"**Спуск в ущелье: Лобсанг**\n\nНаходит тело, впитывает карму, переходит дальше.","x":1880,"y":1302,"width":290,"height":92},
		{"id":"ev_burnt","type":"text","text":"**Обожжённое: лотосы + шест**\n\nСобирает лотосы, берёт выгоревший сонгсранг, не ведая что держит.","x":1880,"y":1428,"width":290,"height":92},
		{"id":"ev_grotto","type":"text","text":"**Грот/питомник (загадка)**\n\nЗапоминает странное, не понимая смысла.","x":1880,"y":1554,"width":290,"height":92},
		{"id":"ev_complete","type":"text","text":"**Достройка договора**\n\nДополняет по колоннам: расторгнуть может кровь Зодчего.","x":1880,"y":2080,"width":290,"height":92},
		{"id":"ev_rockfall","type":"text","text":"**Камнепад**\n\nКорни ловят глыбы в форме рук героя.","x":1880,"y":182,"width":290,"height":92},
		{"id":"ev_ravine","type":"text","text":"**Расселина: карма + переправа**\n\nИзвлекает карму (видение), обретает заметность, наводит мост.","x":1880,"y":308,"width":290,"height":92},
		{"id":"ev_meet_lhamo","type":"text","text":"**Встреча с Лхамо**\n\nЛхамо видит героя, ставит две цели, обещает ключ.","x":1880,"y":434,"width":290,"height":92},
		{"id":"ev_read_column","type":"text","text":"**Чтение колонны**\n\nЦена расторжения — всё оставшееся дыхание.","x":1880,"y":560,"width":290,"height":92},
		{"id":"ev_epilogue","type":"text","text":"**Эпилог (Акт II)**\n\nA: мать дарит яка. B: семья с не в меру любопытной новорождённой.","x":1880,"y":2782,"width":290,"height":92},
		{"id":"mech_extract","type":"text","text":"**Извлечение кармы из трупов**\n\nТопливо маны и каузальность речи. Только герой способен.","x":2350,"y":196,"width":290,"height":92},
		{"id":"mech_causality","type":"text","text":"**Каузальность / видимость**\n\nБез кармы герой невидим миру; извлечённая карма делает заметным.","x":2350,"y":322,"width":290,"height":92},
		{"id":"mech_roots","type":"text","text":"**Верб корней**\n\nВырастить/расчистить/удержать корень. Расходует ману.","x":2350,"y":70,"width":290,"height":92},
		{"id":"mech_forget","type":"text","text":"**Забывание NPC + сомнение**\n\nNPC забывают героя, храня смутное «мы виделись?». Прогресс — в памяти игрока.","x":2350,"y":448,"width":290,"height":110},
		{"id":"mech_mana","type":"text","text":"**Экономика маны**\n\nДиалог бесплатен; корни тратят конечную ману. Детали отложены.","x":2350,"y":592,"width":290,"height":92},
		{"id":"mech_jinsreg","type":"text","text":"**Огонь Жинсрэг**\n\nРвёт кармические связи: малый (гхи) и гневный (треугольный очаг).","x":2350,"y":718,"width":290,"height":92},
		{"id":"mech_prana","type":"text","text":"**Отток праны**\n\nДерево тянет жизнь рода духу: дыхание-нить, утечка в пол, угасание поколений.","x":2350,"y":844,"width":290,"height":110},
		{"id":"mech_songsrang","type":"text","text":"**Извлечение/перенос сонгсранга**\n\nСтержень убивает руку с кармой; пустого героя не трогает — он несёт его как мёртвую вещь.","x":2350,"y":988,"width":290,"height":110},
		{"id":"mech_swap","type":"text","text":"**Своп сонгсрангов**\n\nВставляет выгоревший стержень в живую ступу под видом «починки» — повтор хода духа.","x":2350,"y":1132,"width":290,"height":110,"color":"1"},
		{"id":"mech_intention","type":"text","text":"**Правило намерения**\n\nКарму и обряд решает намерение, не звук/пламя.","x":2350,"y":1276,"width":290,"height":92},
		{"id":"mech_lamps","type":"text","text":"**Зажжение лампад**\n\nРасчищает корнями фитили, ослабляет отток. Действие для Долмы и зеркало сожжения.","x":2350,"y":1402,"width":290,"height":110},
		{"id":"h_lake","type":"text","text":"**Отзвук кармы героя (озеро)**\n\n«Своё, забытое» в первом видении — очищенная карма героя.","x":4230,"y":322,"width":290,"height":92,"color":"6"},
		{"id":"h_illness","type":"text","text":"**Болезнь матери не от дерева**\n\nНинг-лунг не связан с деревом; оно лишь перекрывает путь.","x":4230,"y":448,"width":290,"height":92,"color":"6"},
		{"id":"h_lock","type":"text","text":"**Замок ступы**\n\nДоступ — ёмкость заземлить разряд, не сан; герой проходит пустотой.","x":4230,"y":574,"width":290,"height":92,"color":"6"},
		{"id":"h_motive","type":"text","text":"**Мотив духа (апофеоз)**\n\nПрисваивает пунью, чтобы не пасть и обрести поддельное бессмертие.","x":4230,"y":700,"width":290,"height":92,"color":"6"},
		{"id":"h_nursery","type":"text","text":"**Питомник: живая ось; обман**\n\nДух вывел живую ось, дал Зодчему под видом «договорного камня».","x":4230,"y":826,"width":290,"height":92,"color":"6"},
		{"id":"h_roots_recent","type":"text","text":"**Недавние чёрные корни**\n\nПровал экспансии: насильный сбор пуньи убивает паломников.","x":4230,"y":952,"width":290,"height":92,"color":"6"},
		{"id":"h_seed","type":"text","text":"**Немой посев**\n\nВетвь сожжения питает культистский финал; расторжение — противостоит.","x":4230,"y":1078,"width":290,"height":110,"color":"6"},
		{"id":"th_lotus","type":"text","text":"**Зримая карма (лотос)**\n\nБелый — заслуга (норма); чёрный — отщеплённая карма, подпись культиста.","x":3290,"y":466,"width":290,"height":110},
		{"id":"th_mirror","type":"text","text":"**Долма как зеркало**\n\nЦепляние — отражение антагониста и духа; страх забвения.","x":3290,"y":736,"width":290,"height":92},
		{"id":"th_swap","type":"text","text":"**Подмена = повтор хода духа**\n\nСвоп — миниатюра деяния духа: мёртвая подделка в сердце святыни.","x":3290,"y":862,"width":290,"height":92,"color":"1"},
		{"id":"ch_false","type":"text","text":"**Ложная развязка**\n\nЛекарство дано, мать стабильна — квест будто завершён.","x":3760,"y":70,"width":290,"height":92},
		{"id":"ch_flag","type":"text","text":"**Флаг исхода → Акт II**\n\nЗаписывает «расторгнуто/сожжено»; определяет эпилог и подпитку финала.","x":3760,"y":196,"width":290,"height":110},
		{"id":"open_A","type":"text","text":"**Открытый шов: удержание (A)**\n\nЗащита Лхамо — навык или таймер, не решено.","x":3760,"y":340,"width":290,"height":92,"color":"3"},
		{"id":"open_B","type":"text","text":"**Открытый шов: информированность (B)**\n\nГибель Долмы не телеграфирована до поджога.","x":3760,"y":466,"width":290,"height":114,"color":"3"},
		{"id":"th_idea","type":"text","text":"**Управляющая идея**\n\nУдержать силой против отпустить. A — отпускание, B — накопление.","x":3290,"y":70,"width":290,"height":92},
		{"id":"th_invstupa","type":"text","text":"**Перевёрнутая ступа**\n\nДерево высасывает прану вместо излучения заслуги.","x":3290,"y":196,"width":290,"height":92},
		{"id":"th_fire","type":"text","text":"**Огонь внутрь / наружу**\n\nОдин огонь (гхи), разный умысел: лампады дают свет — Жинсрэг уничтожает.","x":3290,"y":322,"width":290,"height":110},
		{"id":"lhamo","type":"text","text":"**Лхамо**\n\nКочевница старой веры, читает письмо духов, привязывается к герою. Кровь Зодчего.","x":0,"y":214,"width":290,"height":110},
		{"id":"k1","type":"text","text":"**К1: управляю корнями**\n\nПервое знание о силе.","x":2806,"y":44,"width":290,"height":78},
		{"id":"k2","type":"text","text":"**К2: карма мёртвых = сила/заметность**\n\nИзвлечение даёт ману и каузальность.","x":2806,"y":156,"width":290,"height":114},
		{"id":"k11","type":"text","text":"**К11: договор = песня; решает намерение**\n\nНужен умысел расторгнуть.","x":2806,"y":1292,"width":290,"height":96},
		{"id":"k3","type":"text","text":"**К3: договоры; расторжение = смерть**\n\nРазвязавший платит дыханием.","x":2806,"y":304,"width":290,"height":96},
		{"id":"k4","type":"text","text":"**К4: корни рвёт только Жинсрэг**\n\nНи огонь, ни металл — лишь обряд.","x":2806,"y":434,"width":290,"height":78},
		{"id":"k5","type":"text","text":"**К5: существуют Опустошённые**\n\nКонцепт назван, к себе ещё не отнесён.","x":2806,"y":546,"width":290,"height":92},
		{"id":"k6","type":"text","text":"**К6: болезнь от ветра ума**\n\nЛечат джинлабом ступ; карма не сальдируется.","x":2806,"y":672,"width":290,"height":92},
		{"id":"k7","type":"text","text":"**К7: отец мёртв; кровь рода**\n\nТавро — знак рода Зодчего.","x":2806,"y":798,"width":290,"height":78},
		{"id":"k8","type":"text","text":"**К8: дерево; зеркало; родство**\n\nДоговор Долмы; Долма — кровь Лхамо.","x":2806,"y":910,"width":290,"height":92},
		{"id":"k9","type":"text","text":"**К9: я — Опустошённый**\n\nКасался смертельного стержня и жив; в нём нет кармы.","x":2806,"y":1036,"width":290,"height":92},
		{"id":"k10","type":"text","text":"**К10: расторгнуть может кровь Зодчего**\n\nОговорка, достроенная по колоннам.","x":2806,"y":1162,"width":290,"height":96},
		{"id":"th_hollow","type":"text","text":"**Опустошённость**\n\nБез кармы: невидимость, забвение, неуязвимость для заряда.","x":2640,"y":-480,"width":290,"height":180},
		{"id":"ev_vision","type":"text","text":"**Видение отца / бегство**\n\n«Отец» велит идти к монастырю.","x":1880,"y":70,"width":290,"height":78},
		{"id":"prot","type":"text","text":"**Протагонист**\n\nЮноша без памяти, бежал из чёрной цитадели. Управляет корнями. Не знает, что он Опустошённый.","x":-80,"y":-520,"width":430,"height":220},
		{"id":"h_father","type":"text","text":"**«Отец» = дух матери**\n\nВидение носит облик отца, но это дух матери-защитницы.","x":520,"y":-800,"width":290,"height":180,"color":"6"},
		{"id":"goal_father","type":"text","text":"**Цель: найти отца**\n\nВидение «отца» велит идти к монастырю. Внешний двигатель.","x":520,"y":-498,"width":290,"height":176},
		{"id":"h_father_hollow","type":"text","text":"**Отец стал Опустошённым**\n\nДобровольно отдал карму ради договора и исчез.","x":520,"y":-1080,"width":290,"height":180,"color":"6"}
	],
