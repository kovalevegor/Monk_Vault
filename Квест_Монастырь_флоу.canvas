{
	"nodes":[
		{"id":"ev_rockfall","type":"text","text":"**◆ Камнепад**\n\nКорни ловят глыбы в форме рук героя.","x":380,"y":-40,"width":300,"height":80,"color":"#34567a"},
		{"id":"ev_ravine","type":"text","text":"**◆ Расселина: карма + переправа**\n\nИзвлекает карму (видение), обретает заметность, наводит мост.","x":760,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_meet_lhamo","type":"text","text":"**◆ Встреча с Лхамо**\n\nЛхамо видит героя, ставит две цели, обещает ключ.","x":1140,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_read_column","type":"text","text":"**◆ Чтение колонны**\n\nЦена расторжения — всё оставшееся дыхание.","x":1520,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_promise","type":"text","text":"**◆ Обещание подарка**\n\nЛхамо обещает костяной ключ.","x":1900,"y":-40,"width":300,"height":80,"color":"#34567a"},
		{"id":"ev_tsongpa","type":"text","text":"**◆ (Опц.) Цхонпа**\n\nМасло, чужеземный лексикон, речь вопросами.","x":2280,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_tenzin_teach","type":"text","text":"**◆ Тензин: обучение и задание**\n\nУчит Жинсрэгу; поручает собрать благой цвет; вводит врачевание.","x":2660,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_tenzin_lore","type":"text","text":"**◆ Тензин: догадки и намерение**\n\nПроисхождение напасти; недавность корней; правило намерения.","x":3040,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_library","type":"text","text":"**◆ Библиотека: пергаменты**\n\nДухи-движители скал; разряд ступы против корней.","x":3420,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_gorge","type":"text","text":"**◆ Спуск в ущелье: Лобсанг**\n\nНаходит тело, впитывает карму, переходит дальше.","x":3800,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_burnt","type":"text","text":"**◆ Обожжённое: лотосы + шест**\n\nСобирает лотосы, берёт выгоревший сонгсранг, не ведая что держит.","x":4180,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_grotto","type":"text","text":"**◆ Грот/питомник (загадка)**\n\nЗапоминает странное, не понимая смысла.","x":4560,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_dolma","type":"text","text":"**◆ Дом Долмы: рассказ + лампады**\n\nЗажигает лампады (тавро/портреты/договор); виден отток праны; родство с Лхамо.","x":4940,"y":-54,"width":300,"height":108,"color":"#34567a"},
		{"id":"ev_copy","type":"text","text":"**◆ Копирование договора**\n\nКопирует неполный текст со ствола.","x":5320,"y":-40,"width":300,"height":80,"color":"#34567a"},
		{"id":"ev_return_tenzin","type":"text","text":"**◆ Возврат к Тензину: узнавание**\n\nСнадобье готово; реакция на сонгсранг → герой осознаёт, что Опустошённый.","x":5700,"y":-54,"width":300,"height":108,"color":"#34567a"},
		{"id":"ev_complete","type":"text","text":"**◆ Достройка договора**\n\nПо колоннам: расторгнуть может кровь Зодчего.","x":6080,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_return_lhamo","type":"text","text":"**◆ Возврат к Лхамо**\n\nЛекарство матери; копия — её песня; роль намерения.","x":6460,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"ev_choice","type":"text","text":"**◆ ТОЧКА ВЫБОРА**\n\nПередать тавро или сжечь дерево. Действие, не меню.","x":6840,"y":-45,"width":300,"height":90,"color":"3"},
		{"id":"ev_branchA","type":"text","text":"**◆ ВЕТВЬ A: расторжение**\n\nТавро → Лхамо поёт с умыслом, герой держит корни; дерево и Лхамо растворяются; Долма выходит; мать — в менкханг; награда — ключ.","x":7220,"y":-483,"width":300,"height":126,"color":"4"},
		{"id":"ev_branchB","type":"text","text":"**◆ ВЕТВЬ B: сожжение + своп**\n\nПодмена сонгсрангов; гневный Жинсрэг; дерево падает на дом, гибнет Долма, гаснут лампады; Лхамо не узнаёт крови; награда — сонгсранг.","x":7220,"y":357,"width":300,"height":126,"color":"1"},
		{"id":"ev_epilogue","type":"text","text":"**◆ Эпилог (Акт II)**\n\nA: мать дарит яка. B: семья с не в меру любопытной новорождённой.","x":7600,"y":-45,"width":300,"height":90,"color":"#34567a"},
		{"id":"loc_camp","type":"text","text":"**Стоянка Лхамо**\n\nШатёр матери, яки с тавро. Узел встреч и возвратов.","x":1140,"y":-205,"width":300,"height":90},
		{"id":"goal_lhamo","type":"text","text":"**Цель Лхамо**\n\nСпасти мать и найти отца — связь до лора.","x":1140,"y":115,"width":300,"height":90},
		{"id":"goal_path","type":"text","text":"**Цель: открыть путь**\n\nКорни перекрыли тропу и мост; нужно разрешить дерево.","x":1140,"y":-325,"width":300,"height":90},
		{"id":"h_illness","type":"text","text":"**Болезнь матери не от дерева**\n\nНинг-лунг не связан с деревом; оно лишь перекрывает путь.","x":1140,"y":235,"width":300,"height":90,"color":"6"},
		{"id":"lhamo","type":"text","text":"**Лхамо**\n\nКочевница, читает бон, привязывается к герою. Кровь Зодчего.","x":1140,"y":-445,"width":300,"height":90},
		{"id":"mother","type":"text","text":"**Мать Лхамо**\n\nТяжело больна (нинг-лунг), нетранспортабельна.","x":1140,"y":355,"width":300,"height":90},
		{"id":"k7","type":"text","text":"**К7: отец мёртв; кровь рода**\n\nТавро — знак рода Зодчего.","x":3800,"y":-195,"width":300,"height":80,"color":"5"},
		{"id":"loc_gorge","type":"text","text":"**Ущелье (Лобсанг)**\n\nТело Лобсанга; переправа дальше на его карме.","x":3800,"y":115,"width":300,"height":90},
		{"id":"item_tavro","type":"text","text":"**Тавро Лобсанга**\n\nРодовой знак (яки, утварь Долмы). Доказательство крови Зодчего.","x":3800,"y":-315,"width":300,"height":90},
		{"id":"lobsang","type":"text","text":"**Лобсанг**\n\nОтец Лхамо. Погиб в обходе, замёрз.","x":3800,"y":235,"width":300,"height":80},
		{"id":"k8","type":"text","text":"**К8: дерево; зеркало; родство**\n\nДоговор Долмы; Долма — кровь Лхамо.","x":4940,"y":-204,"width":300,"height":80,"color":"5"},
		{"id":"th_fire","type":"text","text":"**Огонь внутрь / наружу**\n\nОдин огонь, разный умысел: лампады — свет, Жинсрэг — гибель.","x":4940,"y":124,"width":300,"height":90,"color":"2"},
		{"id":"th_mirror","type":"text","text":"**Долма как зеркало**\n\nЦепляние — отражение антагониста и духа; страх забвения.","x":4940,"y":-324,"width":300,"height":90,"color":"2"},
		{"id":"loc_tree","type":"text","text":"**Дерево / дом Долмы**\n\nИсполин из дома Зодчего; тёмный лампадный дом. Сердце договора.","x":4940,"y":244,"width":300,"height":90},
		{"id":"mech_lamps","type":"text","text":"**Зажжение лампад**\n\nРасчищает фитили, ослабляет отток. Действие для Долмы и зеркало сожжения.","x":4940,"y":-462,"width":300,"height":108},
		{"id":"mech_prana","type":"text","text":"**Отток праны**\n\nДерево тянет жизнь рода духу: дыхание-нить, утечка, угасание поколений.","x":4940,"y":364,"width":300,"height":90},
		{"id":"goal_dolma","type":"text","text":"**Цель Долмы**\n\nЖить и не быть поглощённой тьмой и забытой.","x":4940,"y":-582,"width":300,"height":90},
		{"id":"dolma","type":"text","text":"**Долма**\n\nПоследняя в роду Зодчего, замурована. Цепляется за жизнь. Зеркало антагониста.","x":4940,"y":484,"width":300,"height":108},
		{"id":"k4","type":"text","text":"**К4: корни рвёт только Жинсрэг**\n\nНи огонь, ни металл — лишь обряд.","x":2660,"y":-195,"width":300,"height":80,"color":"5"},
		{"id":"k6","type":"text","text":"**К6: болезнь от ветра ума**\n\nЛечат джинлабом ступ; карма не сальдируется.","x":2660,"y":115,"width":300,"height":90,"color":"5"},
		{"id":"loc_monks","type":"text","text":"**Жилища монахов + мост**\n\nДом Тензина; мост к монастырю задушен корнями.","x":2660,"y":-315,"width":300,"height":90},
		{"id":"loc_stupa","type":"text","text":"**Обительская ступа**\n\nЦелая ступа; донор живой оси в ветви B.","x":2660,"y":235,"width":300,"height":90},
		{"id":"item_ghi","type":"text","text":"**Масло гхи**\n\nТопливо Жинсрэга и лампад. Связь огня внутри и снаружи.","x":2660,"y":-435,"width":300,"height":90},
		{"id":"item_songsrang_live","type":"text","text":"**Сонгсранг действующей ступы**\n\nПолный заряд живой оси; нужен сжечь дерево. Изъятие убивает ступу.","x":2660,"y":355,"width":300,"height":90,"color":"1"},
		{"id":"mech_jinsreg","type":"text","text":"**Огонь Жинсрэг**\n\nРвёт кармические связи: малый (гхи) и гневный (очаг).","x":2660,"y":-555,"width":300,"height":90},
		{"id":"goal_tenzin","type":"text","text":"**Цель Тензина**\n\nИзбавить обитель от корней.","x":2660,"y":475,"width":300,"height":80},
		{"id":"tenzin","type":"text","text":"**Тензин**\n\nКхенпо. Обучение, врачевание, раскрытия. Не удерживает героя в памяти.","x":2660,"y":-675,"width":300,"height":90},
		{"id":"item_oil","type":"text","text":"**Оливковое масло**\n\nБез кармического веса; «духи не видят». Ружьё инертной кармы.","x":2280,"y":-205,"width":300,"height":90},
		{"id":"tsongpa","type":"text","text":"**Цхонпа**\n\nКупец, чужеземный лексикон, говорит вопросами. Опц.","x":2280,"y":115,"width":300,"height":90},
		{"id":"th_invstupa","type":"text","text":"**Перевёрнутая ступа**\n\nДерево высасывает прану вместо излучения заслуги.","x":4560,"y":-205,"width":300,"height":90,"color":"2"},
		{"id":"loc_grotto","type":"text","text":"**Грот + питомник**\n\nБудды сверху; горшки снизу. Загадка. Функция не задана.","x":4560,"y":115,"width":300,"height":90,"color":"3"},
		{"id":"item_pots","type":"text","text":"**Горшки с саженцами**\n\nСаженцы со знаками бон, радужная искра. Улика без объяснения.","x":4560,"y":-325,"width":300,"height":90},
		{"id":"h_motive","type":"text","text":"**Мотив духа (апофеоз)**\n\nПрисваивает пунью, чтобы не пасть и обрести поддельное бессмертие.","x":4560,"y":235,"width":300,"height":90,"color":"6"},
		{"id":"h_nursery","type":"text","text":"**Питомник: живая ось; обман**\n\nДух вывел живую ось, дал Зодчему под видом «договорного камня».","x":4560,"y":-445,"width":300,"height":90,"color":"6"},
		{"id":"motive_spirit","type":"text","text":"**Мотив духа**\n\nНе пасть: присвоить пунью и поддельное бессмертие.","x":4560,"y":355,"width":300,"height":90,"color":"6"},
		{"id":"spirit","type":"text","text":"**Дух**\n\nСоздатель дерева; физически отсутствует; подменил назначение ступы.","x":4560,"y":-565,"width":300,"height":90,"color":"6"},
		{"id":"k2","type":"text","text":"**К2: карма мёртвых = сила/заметность**\n\nИзвлечение даёт ману и каузальность.","x":760,"y":-211,"width":300,"height":96,"color":"5"},
		{"id":"loc_ravine","type":"text","text":"**Обучающая расселина**\n\nПервый провал; рядом труп паломника.","x":760,"y":115,"width":300,"height":80},
		{"id":"mech_causality","type":"text","text":"**Каузальность / видимость**\n\nБез кармы герой невидим; карма делает заметным.","x":760,"y":-331,"width":300,"height":90},
		{"id":"mech_extract","type":"text","text":"**Извлечение кармы из трупов**\n\nТопливо маны и каузальность речи. Только герой.","x":760,"y":225,"width":300,"height":90},
		{"id":"mech_mana","type":"text","text":"**Экономика маны**\n\nДиалог бесплатен; корни тратят конечную ману. Детали отложены.","x":760,"y":-451,"width":300,"height":90},
		{"id":"mech_roots","type":"text","text":"**Верб корней**\n\nВырастить/расчистить/удержать. Расходует ману.","x":760,"y":345,"width":300,"height":90},
		{"id":"h_lake","type":"text","text":"**Отзвук кармы героя (озеро)**\n\n«Своё, забытое» в видении — очищенная карма героя.","x":760,"y":-571,"width":300,"height":90,"color":"6"},
		{"id":"pilgrim","type":"text","text":"**Мёртвый паломник**\n\nСлишком долго стоял; корни поглотили. Первый источник кармы.","x":760,"y":465,"width":300,"height":90},
		{"id":"k3","type":"text","text":"**К3: договоры; расторжение = смерть**\n\nРазвязавший платит дыханием.","x":1520,"y":-211,"width":300,"height":96,"color":"5"},
		{"id":"loc_trail","type":"text","text":"**Снежные тропы / колонны**\n\nВход. Столпы с письмом духов; фрагменты договора.","x":1520,"y":115,"width":300,"height":90},
		{"id":"item_columns","type":"text","text":"**Каменные колонны**\n\nФрагменты договоров и мантра о намерении.","x":1520,"y":-331,"width":300,"height":90},
		{"id":"loc_library","type":"text","text":"**Библиотека**\n\nДва пергамента. Опц.","x":3420,"y":-195,"width":300,"height":80},
		{"id":"th_lotus","type":"text","text":"**Зримая карма (лотос)**\n\nБелый — заслуга (норма); чёрный — отщеплённая карма, подпись культиста.","x":4180,"y":-205,"width":300,"height":90,"color":"2"},
		{"id":"loc_burnt","type":"text","text":"**Обожжённое место**\n\nВыжженные скалы, белые лотосы, расколотая ступа.","x":4180,"y":115,"width":300,"height":90},
		{"id":"item_lotus","type":"text","text":"**Белые лотосы**\n\nЗримая осёдлая заслуга; сырьё снадобья.","x":4180,"y":-325,"width":300,"height":90},
		{"id":"item_songsrang_cracked","type":"text","text":"**Сонгсранг расколотой ступы**\n\nВыгоревший шест: убьёт руку с кармой, мало для дерева. Узнавание и своп.","x":4180,"y":235,"width":300,"height":90},
		{"id":"mech_songsrang","type":"text","text":"**Перенос сонгсранга**\n\nСтержень убивает руку с кармой; пустого не трогает — несёт как мёртвую вещь.","x":4180,"y":-463,"width":300,"height":108},
		{"id":"k11","type":"text","text":"**К11: договор = песня; решает намерение**\n\nНужен умысел расторгнуть.","x":6460,"y":-211,"width":300,"height":96,"color":"5"},
		{"id":"loc_menkhang","type":"text","text":"**Менкханг**\n\nЛечебница за мостом; цель полного исцеления матери.","x":6460,"y":115,"width":300,"height":90},
		{"id":"item_song","type":"text","text":"**Песня Лхамо = договор**\n\nКолыбельная отца оказывается текстом договора.","x":6460,"y":-331,"width":300,"height":90},
		{"id":"ch_false","type":"text","text":"**Ложная развязка**\n\nЛекарство дано, мать стабильна — квест будто завершён.","x":6460,"y":235,"width":300,"height":90,"color":"3"},
		{"id":"item_key","type":"text","text":"**Костяной ключ**\n\nКлюч к чтению бон; плела «для друга». Награда A.","x":1900,"y":-200,"width":300,"height":90,"color":"4"},
		{"id":"k9","type":"text","text":"**К9: я — Опустошённый**\n\nКасался смертельного стержня и жив; в нём нет кармы.","x":5700,"y":-214,"width":300,"height":90,"color":"5"},
		{"id":"th_hollow","type":"text","text":"**Опустошённость**\n\nБез кармы: невидимость, забвение, неуязвимость для заряда.","x":5700,"y":124,"width":300,"height":90,"color":"2"},
		{"id":"item_remedy","type":"text","text":"**Снадобье**\n\nНа джинлабе из лотосов; усмиряет ветер. Облегчает, не исцеляет.","x":5700,"y":-334,"width":300,"height":90},
		{"id":"mech_forget","type":"text","text":"**Забывание NPC + сомнение**\n\nNPC забывают, храня «мы виделись?». Прогресс — память игрока.","x":5700,"y":244,"width":300,"height":90},
		{"id":"h_lock","type":"text","text":"**Замок ступы**\n\nДоступ — ёмкость заземлить разряд, не сан; герой проходит пустотой.","x":5700,"y":-454,"width":300,"height":90,"color":"6"},
		{"id":"item_copy","type":"text","text":"**Копия договора**\n\nНеполная (корни выели оговорку о властном расторгнуть).","x":5320,"y":-200,"width":300,"height":90},
		{"id":"th_swap","type":"text","text":"**Подмена = повтор хода духа**\n\nСвоп — миниатюра деяния духа: подделка в сердце святыни.","x":7220,"y":553,"width":300,"height":90,"color":"1"},
		{"id":"mech_swap","type":"text","text":"**Своп сонгсрангов**\n\nВыгоревший в живую ступу под видом «починки» — повтор хода духа.","x":7220,"y":673,"width":300,"height":90,"color":"1"},
		{"id":"h_seed","type":"text","text":"**Немой посев**\n\nВетвь сожжения питает культистский финал; расторжение — против.","x":7220,"y":793,"width":300,"height":90,"color":"6"},
		{"id":"open_B","type":"text","text":"**Открытый шов: информированность (B)**\n\nГибель Долмы не телеграфирована до поджога.","x":7220,"y":913,"width":300,"height":114,"color":"3"},
		{"id":"k5","type":"text","text":"**К5: существуют Опустошённые**\n\nКонцепт назван, к себе не отнесён.","x":3040,"y":-195,"width":300,"height":80,"color":"5"},
		{"id":"mech_intention","type":"text","text":"**Правило намерения**\n\nКарму и обряд решает намерение, не звук/пламя.","x":3040,"y":115,"width":300,"height":90},
		{"id":"h_roots_recent","type":"text","text":"**Недавние чёрные корни**\n\nПровал экспансии: насильный сбор пуньи убивает паломников.","x":3040,"y":-315,"width":300,"height":90,"color":"6"},
		{"id":"k10","type":"text","text":"**К10: расторгнуть может кровь Зодчего**\n\nОговорка, достроенная по колоннам.","x":6080,"y":-211,"width":300,"height":96,"color":"5"},
		{"id":"th_idea","type":"text","text":"**Управляющая идея**\n\nУдержать силой против отпустить. A — отпускание, B — накопление.","x":6840,"y":-205,"width":300,"height":90,"color":"2"},
		{"id":"ch_flag","type":"text","text":"**Флаг исхода → Акт II**\n\nЗаписывает «расторгнуто/сожжено»; определяет эпилог и финал.","x":7600,"y":-205,"width":300,"height":90,"color":"3"},
		{"id":"open_A","type":"text","text":"**Открытый шов: удержание (A)**\n\nЗащита Лхамо — навык или таймер, не решено.","x":7220,"y":-643,"width":300,"height":90,"color":"3"},
		{"id":"ev_vision","type":"text","text":"**◆ Видение отца / бегство**\n\n«Отец» велит идти к монастырю.","x":-20,"y":-75,"width":300,"height":150,"color":"#34567a"},
		{"id":"prot","type":"text","text":"**Протагонист**\n\nЮноша без памяти; управляет корнями; не знает, что Опустошённый.","x":-520,"y":-110,"width":300,"height":210},
		{"id":"goal_father","type":"text","text":"**Цель: найти отца**\n\nВидение велит идти к монастырю. Внешний двигатель.","x":-20,"y":-335,"width":300,"height":175},
		{"id":"h_father_hollow","type":"text","text":"**Отец стал Опустошённым**\n\nОтдал карму ради договора и исчез.","x":-520,"y":-840,"width":300,"height":197,"color":"6"},
		{"id":"h_father","type":"text","text":"**«Отец» = дух матери**\n\nВидение носит облик отца, но это дух матери-защитницы.","x":-520,"y":-571,"width":300,"height":171,"color":"6"},
		{"id":"k1","type":"text","text":"**К1: управляю корнями**\n\nПервое знание о силе.","x":380,"y":-325,"width":300,"height":130,"color":"5"},
		{"id":"loc_cliff","type":"text","text":"**Утёс (камнепад)**\n\nМесто пробуждения силы.","x":380,"y":115,"width":300,"height":125}
	],
