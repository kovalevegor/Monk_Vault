{
	"nodes":[
		{"id":"ev_vision","type":"text","text":"**Видение отца / бегство**\n\n«Отец» велит идти к монастырю.","x":-160,"y":127,"width":320,"height":74,"color":"5"},
		{"id":"goal_father","type":"text","text":"**Цель: найти отца**\n\nВидение «отца» велит идти к монастырю. Внешний двигатель.","x":-485,"y":130,"width":250,"height":84},
		{"id":"h_father","type":"text","text":"**«Отец» = дух матери**\n\nВидение носит облик отца, но это дух матери-защитницы.","x":-485,"y":240,"width":250,"height":84,"color":"6"},
		{"id":"tenzin","type":"text","text":"**Тензин**\n\nКхенпо монастыря. Источник обучения, врачевания и раскрытий. Не может удержать героя в памяти.","x":235,"y":0,"width":250,"height":118},
		{"id":"goal_tenzin","type":"text","text":"**Цель Тензина**\n\nИзбавить обитель от корней.","x":235,"y":144,"width":250,"height":74},
		{"id":"h_father_hollow","type":"text","text":"**Отец стал Опустошённым**\n\nДобровольно отдал карму ради договора и исчез.","x":235,"y":244,"width":250,"height":84,"color":"6"},
		{"id":"ev_rockfall","type":"text","text":"**Камнепад**\n\nКорни ловят глыбы в форме рук героя.","x":-160,"y":398,"width":320,"height":74,"color":"5"},
		{"id":"loc_cliff","type":"text","text":"**Утёс (камнепад)**\n\nМесто пробуждения силы.","x":-485,"y":398,"width":250,"height":74},
		{"id":"k1","type":"text","text":"**К1: управляю корнями**\n\nПервое знание о силе.","x":235,"y":398,"width":250,"height":74},
		{"id":"ev_ravine","type":"text","text":"**Расселина: карма + переправа**\n\nИзвлекает карму (видение), обретает заметность, наводит мост.","x":-160,"y":842,"width":320,"height":84,"color":"5"},
		{"id":"pilgrim","type":"text","text":"**Мёртвый паломник**\n\nСлишком долго стоял на месте; корни поглотили его. Первый источник кармы и каузальности.","x":-485,"y":542,"width":250,"height":101},
		{"id":"mech_causality","type":"text","text":"**Каузальность / видимость**\n\nБез кармы герой невидим миру; извлечённая карма делает заметным.","x":-485,"y":669,"width":250,"height":101},
		{"id":"mech_forget","type":"text","text":"**Забывание NPC + сомнение**\n\nNPC забывают героя, храня смутное «мы виделись?». Прогресс — в памяти игрока.","x":-485,"y":796,"width":250,"height":101},
		{"id":"mech_roots","type":"text","text":"**Верб корней**\n\nВырастить/расчистить/удержать корень. Расходует ману.","x":-485,"y":923,"width":250,"height":84},
		{"id":"h_lake","type":"text","text":"**Отзвук кармы героя (озеро)**\n\n«Своё, забытое» в первом видении — очищенная карма героя.","x":-485,"y":1033,"width":250,"height":84,"color":"6"},
		{"id":"h_roots_recent","type":"text","text":"**Недавние чёрные корни**\n\nПровал экспансии: насильный сбор пуньи убивает паломников.","x":-485,"y":1143,"width":250,"height":84,"color":"6"},
		{"id":"loc_ravine","type":"text","text":"**Обучающая расселина**\n\nПервый провал; рядом труп паломника.","x":235,"y":604,"width":250,"height":84},
		{"id":"mech_extract","type":"text","text":"**Извлечение кармы из трупов**\n\nТопливо маны и каузальность речи. Только герой способен.","x":235,"y":714,"width":250,"height":84},
		{"id":"mech_mana","type":"text","text":"**Экономика маны**\n\nДиалог бесплатен; корни тратят конечную ману. Детали отложены.","x":235,"y":824,"width":250,"height":84},
		{"id":"k2","type":"text","text":"**К2: карма мёртвых = сила/заметность**\n\nИзвлечение даёт ману и каузальность.","x":235,"y":934,"width":250,"height":104},
		{"id":"h_motive","type":"text","text":"**Мотив духа (апофеоз)**\n\nПрисваивает пунью, чтобы не пасть и обрести поддельное бессмертие.","x":235,"y":1064,"width":250,"height":101,"color":"6"},
		{"id":"ev_meet_lhamo","type":"text","text":"**Встреча с Лхамо**\n\nЛхамо видит героя, ставит две цели, обещает ключ.","x":-160,"y":1360,"width":320,"height":84,"color":"5"},
		{"id":"lobsang","type":"text","text":"**Лобсанг**\n\nОтец Лхамо. Погиб в обходе, замёрз. Найден мёртвым в ущелье.","x":-485,"y":1297,"width":250,"height":84},
		{"id":"item_tavro","type":"text","text":"**Тавро Лобсанга**\n\nРодовой знак; тот же на яках и утвари Долмы. Доказательство крови Зодчего.","x":-485,"y":1407,"width":250,"height":101},
		{"id":"loc_camp","type":"text","text":"**Стоянка Лхамо**\n\nШатёр матери, яки с тавро. Узел встреч и возвратов.","x":235,"y":1360,"width":250,"height":84},
		{"id":"ev_read_column","type":"text","text":"**Чтение колонны**\n\nЦена расторжения — всё оставшееся дыхание.","x":-160,"y":1579,"width":320,"height":84,"color":"5"},
		{"id":"loc_trail","type":"text","text":"**Снежные тропы / колонны**\n\nВход. Столпы с письмом духов. Хранят фрагменты договора.","x":-485,"y":1579,"width":250,"height":84},
		{"id":"k3","type":"text","text":"**К3: договоры; расторжение = смерть**\n\nРазвязавший платит дыханием.","x":235,"y":1578,"width":250,"height":87},
		{"id":"ev_promise","type":"text","text":"**Обещание подарка**\n\nЛхамо обещает костяной ключ.","x":-160,"y":1748,"width":320,"height":74,"color":"5"},
		{"id":"lhamo","type":"text","text":"**Лхамо**\n\nКочевница старой веры, читает письмо духов, привязывается к герою. Кровь Зодчего.","x":-485,"y":1735,"width":250,"height":101},
		{"id":"item_key","type":"text","text":"**Костяной ключ**\n\nКлюч к чтению бон. Лхамо плела «для друга». Награда ветви A.","x":235,"y":1743,"width":250,"height":84,"color":"4"},
		{"id":"ev_tsongpa","type":"text","text":"**(Опц.) Цхонпа**\n\nМасло, чужеземный лексикон, речь вопросами.","x":-160,"y":1914,"width":320,"height":84,"color":"5"},
		{"id":"tsongpa","type":"text","text":"**Цхонпа**\n\nКупец, чужеземный товар и лексикон, говорит вопросами. Опционально.","x":-485,"y":1906,"width":250,"height":101},
		{"id":"item_oil","type":"text","text":"**Оливковое масло**\n\nБез кармического веса; «духи не видят». Ружьё инертной кармы.","x":235,"y":1914,"width":250,"height":84},
		{"id":"ev_tenzin_teach","type":"text","text":"**Тензин: обучение и задание**\n\nУчит Жинсрэгу; поручает собрать благой цвет; вводит врачевание.","x":-160,"y":2205,"width":320,"height":84,"color":"5"},
		{"id":"goal_lhamo","type":"text","text":"**Цель Лхамо**\n\nСпасти мать и найти отца — две задачи, что строят связь до лора.","x":-485,"y":2077,"width":250,"height":101},
		{"id":"item_ghi","type":"text","text":"**Масло гхи**\n\nТопливо Жинсрэга и лампад. Связь огня внутри и снаружи.","x":-485,"y":2204,"width":250,"height":84},
		{"id":"k4","type":"text","text":"**К4: корни рвёт только Жинсрэг**\n\nНи огонь, ни металл — лишь обряд.","x":-485,"y":2314,"width":250,"height":104},
		{"id":"loc_monks","type":"text","text":"**Жилища монахов + мост**\n\nДом Тензина; мост к монастырю задушен корнями.","x":235,"y":2087,"width":250,"height":84},
		{"id":"mech_jinsreg","type":"text","text":"**Огонь Жинсрэг**\n\nРвёт кармические связи: малый (гхи) и гневный (треугольный очаг).","x":235,"y":2197,"width":250,"height":101},
		{"id":"k6","type":"text","text":"**К6: болезнь от ветра ума**\n\nЛечат джинлабом ступ; карма не сальдируется.","x":235,"y":2324,"width":250,"height":84},
		{"id":"ev_tenzin_lore","type":"text","text":"**Тензин: догадки и намерение**\n\nПроисхождение напасти; недавность корней; правило намерения.","x":-160,"y":2488,"width":320,"height":84,"color":"5"},
		{"id":"k5","type":"text","text":"**К5: существуют Опустошённые**\n\nКонцепт назван, к себе ещё не отнесён.","x":-485,"y":2488,"width":250,"height":84},
		{"id":"ev_library","type":"text","text":"**Библиотека: пергаменты**\n\nДухи-движители скал; разряд ступы против корней.","x":-160,"y":2642,"width":320,"height":84,"color":"5"},
		{"id":"loc_library","type":"text","text":"**Библиотека**\n\nДва пергамента. Опционально.","x":-485,"y":2647,"width":250,"height":74},
		{"id":"ev_gorge","type":"text","text":"**Спуск в ущелье: Лобсанг**\n\nНаходит тело, впитывает карму, переходит дальше.","x":-160,"y":3053,"width":320,"height":84,"color":"5"},
		{"id":"spirit","type":"text","text":"**Дух**\n\nСоздатель дерева. Физически отсутствует, рассеян в дереве и договоре. Подменил назначение ступы.","x":-485,"y":2796,"width":250,"height":118,"color":"6"},
		{"id":"loc_burnt","type":"text","text":"**Обожжённое место**\n\nВыжженные скалы, белые лотосы, расколотая ступа с выгоревшим стержнем.","x":-485,"y":2940,"width":250,"height":101},
		{"id":"loc_grotto","type":"text","text":"**Грот + питомник**\n\nИзваяния Будд; под ними потайные горшки. Загадка. Функция не задана.","x":-485,"y":3067,"width":250,"height":101,"color":"3"},
		{"id":"k7","type":"text","text":"**К7: отец мёртв; кровь рода**\n\nТавро — знак рода Зодчего.","x":-485,"y":3194,"width":250,"height":74},
		{"id":"h_nursery","type":"text","text":"**Питомник: живая ось; обман**\n\nДух вывел живую ось, дал Зодчему под видом «договорного камня».","x":-485,"y":3294,"width":250,"height":101,"color":"6"},
		{"id":"motive_spirit","type":"text","text":"**Мотив духа**\n\nНе пасть: присвоить чужую пунью и поддельное бессмертие.","x":235,"y":2880,"width":250,"height":84,"color":"6"},
		{"id":"loc_gorge","type":"text","text":"**Ущелье (Лобсанг)**\n\nТело Лобсанга; переправа дальше на его карме.","x":235,"y":2990,"width":250,"height":84},
		{"id":"loc_tree","type":"text","text":"**Дерево / дом Долмы**\n\nИсполин из дома Зодчего; дом тёмный, сырой, лампадный. Сердце договора.","x":235,"y":3100,"width":250,"height":101},
		{"id":"th_invstupa","type":"text","text":"**Перевёрнутая ступа**\n\nДерево высасывает прану вместо излучения заслуги.","x":235,"y":3227,"width":250,"height":84},
		{"id":"ev_burnt","type":"text","text":"**Обожжённое: лотосы + шест**\n\nСобирает лотосы, берёт выгоревший сонгсранг, не ведая что держит.","x":-160,"y":3528,"width":320,"height":84,"color":"5"},
		{"id":"item_lotus","type":"text","text":"**Белые лотосы**\n\nЗримая осёдлая заслуга; сырьё снадобья.","x":-485,"y":3465,"width":250,"height":84},
		{"id":"th_lotus","type":"text","text":"**Зримая карма (лотос)**\n\nБелый — заслуга (норма); чёрный — отщеплённая карма, подпись культиста.","x":-485,"y":3575,"width":250,"height":101},
		{"id":"item_songsrang_cracked","type":"text","text":"**Сонгсранг расколотой ступы**\n\nВыгоревший шест: убьёт руку с кармой, но мало для дерева. Вещь узнавания и свопа.","x":235,"y":3520,"width":250,"height":101},
		{"id":"ev_grotto","type":"text","text":"**Грот/питомник (загадка)**\n\nЗапоминает странное, не понимая смысла.","x":-160,"y":3759,"width":320,"height":74,"color":"5"},
		{"id":"item_pots","type":"text","text":"**Горшки с саженцами**\n\nСаженцы со знаками бон, радужная искра дерева. Улика без объяснения.","x":-485,"y":3746,"width":250,"height":101},
		{"id":"ev_dolma","type":"text","text":"**Дом Долмы: рассказ + лампады**\n\nЗажигает лампады, что открывают тавро/портреты/договор; виден отток праны; родство с Лхамо.","x":-160,"y":4100,"width":320,"height":101,"color":"5"},
		{"id":"dolma","type":"text","text":"**Долма**\n\nПоследняя в роду Зодчего, замурована в тёмном доме. Цепляется за жизнь. Зеркало антагониста.","x":-485,"y":3917,"width":250,"height":101},
		{"id":"item_song","type":"text","text":"**Песня Лхамо = договор**\n\nКолыбельная отца оказывается текстом договора.","x":-485,"y":4044,"width":250,"height":84},
		{"id":"mech_lamps","type":"text","text":"**Зажжение лампад**\n\nРасчищает корнями фитили, ослабляет отток. Действие для Долмы и зеркало сожжения.","x":-485,"y":4154,"width":250,"height":101},
		{"id":"k8","type":"text","text":"**К8: дерево; зеркало; родство**\n\nДоговор Долмы; Долма — кровь Лхамо.","x":-485,"y":4281,"width":250,"height":104},
		{"id":"goal_dolma","type":"text","text":"**Цель Долмы**\n\nЖить и не быть поглощённой тьмой и забытой как последняя в роду.","x":235,"y":3982,"width":250,"height":101},
		{"id":"mech_intention","type":"text","text":"**Правило намерения**\n\nКарму и обряд решает намерение, не звук/пламя.","x":235,"y":4109,"width":250,"height":84},
		{"id":"mech_prana","type":"text","text":"**Отток праны**\n\nДерево тянет жизнь рода духу: дыхание-нить, утечка в пол, угасание поколений.","x":235,"y":4219,"width":250,"height":101},
		{"id":"ev_copy","type":"text","text":"**Копирование договора**\n\nКопирует неполный текст со ствола.","x":-160,"y":4460,"width":320,"height":74,"color":"5"},
		{"id":"item_copy","type":"text","text":"**Копия договора**\n\nНеполная (корни выели оговорку о властном расторгнуть).","x":-485,"y":4455,"width":250,"height":84},
		{"id":"ev_return_tenzin","type":"text","text":"**Возврат к Тензину: узнавание**\n\nСнадобье готово; реакция на сонгсранг → герой осознаёт, что он Опустошённый.","x":-160,"y":4736,"width":320,"height":84,"color":"5"},
		{"id":"item_remedy","type":"text","text":"**Снадобье**\n\nНа джинлабе из лотосов; усмиряет ветер. Облегчает, не исцеляет.","x":-485,"y":4609,"width":250,"height":101},
		{"id":"k9","type":"text","text":"**К9: я — Опустошённый**\n\nКасался смертельного стержня и жив; в нём нет кармы.","x":-485,"y":4736,"width":250,"height":84},
		{"id":"h_lock","type":"text","text":"**Замок ступы**\n\nДоступ — ёмкость заземлить разряд, не сан; герой проходит пустотой.","x":-485,"y":4846,"width":250,"height":101,"color":"6"},
		{"id":"mech_songsrang","type":"text","text":"**Извлечение/перенос сонгсранга**\n\nСтержень убивает руку с кармой; пустого героя не трогает — он несёт его как мёртвую вещь.","x":235,"y":4662,"width":250,"height":121},
		{"id":"th_hollow","type":"text","text":"**Опустошённость**\n\nБез кармы: невидимость, забвение, неуязвимость для заряда.","x":235,"y":4809,"width":250,"height":84},
		{"id":"ev_complete","type":"text","text":"**Достройка договора**\n\nДополняет по колоннам: расторгнуть может кровь Зодчего.","x":-160,"y":5027,"width":320,"height":84,"color":"5"},
		{"id":"item_columns","type":"text","text":"**Каменные колонны**\n\nФрагменты договоров и мантра о намерении.","x":-485,"y":5027,"width":250,"height":84},
		{"id":"k10","type":"text","text":"**К10: расторгнуть может кровь Зодчего**\n\nОговорка, достроенная по колоннам.","x":235,"y":5017,"width":250,"height":104},
		{"id":"ev_return_lhamo","type":"text","text":"**Возврат к Лхамо**\n\nЛекарство матери; копия — её песня; роль намерения.","x":-160,"y":5192,"width":320,"height":84,"color":"5"},
		{"id":"k11","type":"text","text":"**К11: договор = песня; решает намерение**\n\nНужен умысел расторгнуть.","x":-485,"y":5191,"width":250,"height":87},
		{"id":"ch_false","type":"text","text":"**Ложная развязка**\n\nЛекарство дано, мать стабильна — квест будто завершён.","x":235,"y":5192,"width":250,"height":84},
		{"id":"ev_choice","type":"text","text":"**Точка выбора**\n\nПередать тавро или сжечь дерево. Действие, не меню.","x":-160,"y":5413,"width":320,"height":84,"color":"3"},
		{"id":"goal_path","type":"text","text":"**Цель: открыть путь**\n\nКорни перекрыли тропу и мост; нужно разрешить проблему дерева.","x":-485,"y":5348,"width":250,"height":84},
		{"id":"open_B","type":"text","text":"**Открытый шов: информированность (B)**\n\nГибель Долмы не телеграфирована до поджога.","x":-485,"y":5458,"width":250,"height":104,"color":"3"},
		{"id":"open_A","type":"text","text":"**Открытый шов: удержание (A)**\n\nЗащита Лхамо — навык или таймер, не решено.","x":235,"y":5413,"width":250,"height":84,"color":"3"},
		{"id":"ev_branchA","type":"text","text":"**Ветвь A: расторжение**\n\nТавро → Лхамо поёт с умыслом, герой держит корни; дерево и Лхамо растворяются; Долма выходит; мать — в менкханг; награда — ключ.","x":-160,"y":5678,"width":320,"height":118,"color":"4"},
		{"id":"loc_menkhang","type":"text","text":"**Менкханг**\n\nЛечебница за мостом; цель полного исцеления матери.","x":-485,"y":5632,"width":250,"height":84},
		{"id":"ch_flag","type":"text","text":"**Флаг исхода → Акт II**\n\nЗаписывает «расторгнуто/сожжено»; определяет эпилог и подпитку финала.","x":-485,"y":5742,"width":250,"height":101},
		{"id":"th_idea","type":"text","text":"**Управляющая идея**\n\nУдержать силой против отпустить. A — отпускание, B — накопление.","x":235,"y":5632,"width":250,"height":101},
		{"id":"h_illness","type":"text","text":"**Болезнь матери не от дерева**\n\nНинг-лунг не связан с деревом; оно лишь перекрывает путь.","x":235,"y":5759,"width":250,"height":84,"color":"6"},
		{"id":"ev_branchB","type":"text","text":"**Ветвь B: сожжение + своп**\n\nПодмена сонгсрангов; гневный Жинсрэг; дерево падает на дом, гибнет Долма, гаснут лампады; Лхамо не узнаёт крови; награда — сонгсранг.","x":-160,"y":6031,"width":320,"height":118,"color":"1"},
		{"id":"loc_stupa","type":"text","text":"**Обительская ступа**\n\nЦелая ступа; донор живой оси в ветви B.","x":-485,"y":5921,"width":250,"height":84},
		{"id":"mech_swap","type":"text","text":"**Своп сонгсрангов**\n\nВставляет выгоревший стержень в живую ступу под видом «починки» — повтор хода духа.","x":-485,"y":6031,"width":250,"height":101,"color":"1"},
		{"id":"th_swap","type":"text","text":"**Подмена = повтор хода духа**\n\nСвоп — миниатюра деяния духа: мёртвая подделка в сердце святыни.","x":-485,"y":6158,"width":250,"height":101,"color":"1"},
		{"id":"item_songsrang_live","type":"text","text":"**Сонгсранг действующей ступы**\n\nПолный заряд живой оси; нужен сжечь дерево. Изъятие убивает ступу.","x":235,"y":5913,"width":250,"height":101,"color":"1"},
		{"id":"th_fire","type":"text","text":"**Огонь внутрь / наружу**\n\nОдин огонь (гхи), разный умысел: лампады дают свет — Жинсрэг уничтожает.","x":235,"y":6040,"width":250,"height":101},
		{"id":"h_seed","type":"text","text":"**Немой посев**\n\nВетвь сожжения питает культистский финал; расторжение — противостоит.","x":235,"y":6167,"width":250,"height":101,"color":"6"},
		{"id":"ev_epilogue","type":"text","text":"**Эпилог (Акт II)**\n\nA: мать дарит яка. B: семья с не в меру любопытной новорождённой.","x":-160,"y":6346,"width":320,"height":84,"color":"5"},
		{"id":"mother","type":"text","text":"**Мать Лхамо**\n\nТяжело больна (нинг-лунг), нетранспортабельна. Двигатель квеста медицины.","x":-485,"y":6338,"width":250,"height":101},
		{"id":"th_mirror","type":"text","text":"**Долма как зеркало**\n\nЦепляние — отражение антагониста и духа; страх забвения.","x":235,"y":6346,"width":250,"height":84},
		{"id":"prot","type":"text","text":"**Протагонист**\n\nЮноша без памяти, бежал из чёрной цитадели. Управляет корнями. Не знает, что он Опустошённый.","x":-485,"y":-180,"width":250,"height":264}
	],
